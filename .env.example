# ─── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # set to "production" to require signed webhooks
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text                  # "json" for SIEM ingestion (ELK, Splunk, ...)

# ─── Telegram Bot ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USERS=12345678,87654321
# Chat that receives Commit Guardian alerts
DEFAULT_TELEGRAM_CHAT_ID=

# ─── GitHub (Commit Guardian webhook) ─────────────────────────────────
GITHUB_WEBHOOK_SECRET=change_me_to_a_long_random_string
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Web ───────────────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3000
# Extra browser origins, comma-separated (never "*")
CORS_ALLOW_ORIGINS=

# ─── AI: local by default (source code never leaves your servers) ─────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
AI_SUMMARY_TIMEOUT_SECONDS=90
MAX_CONCURRENT_LLM_JOBS=1

# Cloud LLMs are DISABLED unless you opt in explicitly. With ALLOW_CLOUD_LLM=false,
# LLM_PROVIDER is forced to "ollama" and the keys below are ignored.
ALLOW_CLOUD_LLM=false
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ─── Scanners & reports ───────────────────────────────────────────────
SEMGREP_CONFIG=auto
SCAN_TIMEOUT_SECONDS=300
SCAN_OUTPUT_DIR=./reports
REPORT_PDF_ENABLED=true
# TTF with Cyrillic glyphs; auto-detected when empty
REPORT_FONT_PATH=
TEMP_CLONE_DIR=./temp_scans
METRICS_DB_PATH=./data/commit_guardian.db
