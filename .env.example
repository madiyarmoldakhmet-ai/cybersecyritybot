# App Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USERS=12345678,87654321

# GitHub Authentication & Integration (Proof of Ownership & Auto-PR)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# AI / LLM Configuration
# Options: "openrouter", "gemini" or "ollama"
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Best for Claude 3.5 Sonnet / GPT-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Fallback / Direct Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback / Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Scanner Settings
SEMGREP_CONFIG=auto
SCAN_TIMEOUT_SECONDS=300
SCAN_OUTPUT_DIR=./reports
TEMP_CLONE_DIR=./temp_scans
